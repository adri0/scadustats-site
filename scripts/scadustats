#!/usr/bin/env bash
# Runs the scadustats extraction tool (a separate project/checkout) against this
# repo's data/ directory, e.g.:
#
#   scripts/scadustats extract <youtube-url>
#   scripts/scadustats square consolidate
#   scripts/scadustats player consolidate
#
# scadustats has its own pyproject.toml/venv; this repo has no Python tooling of
# its own, so this just runs it via `uv run --project` from the scadustats
# checkout while keeping the working directory here -- scadustats' data_dir
# options all default to ./data, which then resolves to this repo's data/.
#
# Assumes a sibling checkout at ../scadustats; set SCADUSTATS_DIR to override
# (e.g. when working out of a scadustats worktree instead).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scadustats_dir="${SCADUSTATS_DIR:-$repo_root/../scadustats}"

if [ ! -f "$scadustats_dir/pyproject.toml" ]; then
    echo "error: no scadustats checkout found at $scadustats_dir" >&2
    echo "  check out scadustats there, or set SCADUSTATS_DIR to point at your checkout" >&2
    exit 1
fi

cd "$repo_root"
exec uv run --project "$scadustats_dir" scadustats "$@"
