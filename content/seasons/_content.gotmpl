{{- $allMatches := slice -}}
{{- range $seasonDir, $matchesInSeason := hugo.Data.matches -}}
  {{- range $videoID, $match := $matchesInSeason -}}
    {{- $allMatches = $allMatches | append (partial "lib/match-summary.html" $match) -}}
  {{- end -}}
{{- end -}}

{{- $seasonIDs := slice -}}
{{- range hugo.Data.seasons -}}
  {{- $seasonIDs = $seasonIDs | append (printf "%v" .id) -}}
{{- end -}}
{{- range $allMatches -}}
  {{- if not (in $seasonIDs .season_id) -}}
    {{- $seasonIDs = $seasonIDs | append .season_id -}}
  {{- end -}}
{{- end -}}

{{- range $sid := $seasonIDs -}}
  {{- $season := partial "lib/season-lookup.html" $sid -}}
  {{- $seasonMatches := where $allMatches "season_id" $sid -}}

  {{- /* Per-player record, keyed by slug. Matches count once decided; games
         with no winner (undecided/unfinished) count as game draws. */ -}}
  {{- $standings := dict -}}
  {{- range $m := $seasonMatches -}}
    {{- $gameDraws := sub $m.num_games (add $m.red_score $m.blue_score) -}}
    {{- range $side := slice "red" "blue" -}}
      {{- $p := index $m (printf "player_%s" $side) -}}
      {{- $for := cond (eq $side "red") $m.red_score $m.blue_score -}}
      {{- $against := cond (eq $side "red") $m.blue_score $m.red_score -}}
      {{- $row := index $standings $p.slug | default (dict "player" $p
          "wins" 0 "losses" 0 "draws" 0 "game_wins" 0 "game_losses" 0 "game_draws" 0) -}}
      {{- $row = merge $row (dict
          "wins" (add $row.wins (cond (eq $m.winner $side) 1 0))
          "losses" (add $row.losses (cond (and (ne $m.winner "") (ne $m.winner "draw") (ne $m.winner $side)) 1 0))
          "draws" (add $row.draws (cond (eq $m.winner "draw") 1 0))
          "game_wins" (add $row.game_wins $for)
          "game_losses" (add $row.game_losses $against)
          "game_draws" (add $row.game_draws $gameDraws)) -}}
      {{- $standings = merge $standings (dict $p.slug $row) -}}
    {{- end -}}
  {{- end -}}

  {{- $matchList := slice -}}
  {{- range $seasonMatches -}}
    {{- $matchList = $matchList | append (dict
        "video_id" .video_id
        "match_date" .match_date
        "player_red" .player_red
        "player_blue" .player_blue
        "red_score" .red_score
        "blue_score" .blue_score
        "winner" .winner
        "match_type" .match_type
        "path" (printf "/matches/season-%s/%s/" .season_id (lower .video_id))) -}}
  {{- end -}}

  {{- $.AddPage (dict
      "path" $sid
      "title" ($season.name | default (printf "Season %s" $sid))
      "kind" "page"
      "params" (dict
        "id" $sid
        "name" ($season.name | default (printf "Season %s" $sid))
        "start_date" ($season.start_date | default "")
        "end_date" ($season.end_date | default "")
        "bracket_type" ($season.bracket_type | default "")
        "blurb" ($season.blurb | default "")
        "rules" ($season.rules | default "")
        "unregistered" ($season.unregistered | default false)
        "standings" $standings
        "matches" (sort $matchList "match_date" "desc"))) -}}
{{- end -}}
