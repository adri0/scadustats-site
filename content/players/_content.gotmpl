{{- /* Independently recomputes from raw hugo.Data.* -- never reads pages
       generated by other content adapters (execution order isn't guaranteed
       across sections). The stat fields in data/players/<slug>/stats.yaml are
       ignored for the same reason: data/matches is the only source of truth
       for numbers. */ -}}
{{- $allMatches := slice -}}
{{- range $seasonDir, $matchesInSeason := hugo.Data.matches -}}
  {{- range $videoID, $match := $matchesInSeason -}}
    {{- /* The data file key is what content/matches uses for the page path. */ -}}
    {{- $allMatches = $allMatches | append (merge (partial "lib/match-summary.html" $match) (dict "key" $videoID)) -}}
  {{- end -}}
{{- end -}}

{{- $playerSlugs := slice -}}
{{- $playerObjs := dict -}}
{{- range $slug, $entry := hugo.Data.players -}}
  {{- $stats := $entry.stats | default dict -}}
  {{- $info := $entry.info | default dict -}}
  {{- $name := $stats.display_name | default $info.slug | default $slug -}}
  {{- $player := partial "lib/player-lookup.html" $name -}}
  {{- $playerSlugs = $playerSlugs | append $player.slug -}}
  {{- $playerObjs = merge $playerObjs (dict $player.slug $player) -}}
{{- end -}}
{{- /* A 2v2 side (Season 5) is a team, credited to both of its players (see
       lib/side-lookup.html); a team itself has no page. */ -}}
{{- range $allMatches -}}
  {{- range $side := slice .player_red .player_blue -}}
    {{- range (cond ($side.team | default false) $side.members (slice $side)) -}}
      {{- if not (in $playerSlugs .slug) -}}
        {{- $playerSlugs = $playerSlugs | append .slug -}}
        {{- $playerObjs = merge $playerObjs (dict .slug .) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $slug := $playerSlugs -}}
  {{- $player := index $playerObjs $slug -}}
  {{- $matches := slice -}}
  {{- $wins := 0 -}}
  {{- $losses := 0 -}}
  {{- $draws := 0 -}}
  {{- $noDecision := 0 -}}
  {{- $bySeason := dict -}}
  {{- $gameWins := 0 -}}
  {{- $gameLosses := 0 -}}
  {{- $byGameType := dict -}}
  {{- $baseSquares := dict -}}
  {{- $dlcSquares := dict -}}
  {{- $coopSquares := dict -}}
  {{- range $allMatches -}}
    {{- $m := . -}}
    {{- /* In a 2v2 match, $role is the game this player plays for their team:
           "base" or "dlc". Their marks are the squares of that game, plus the
           co-op squares the team claims together. */ -}}
    {{- $isRed := eq $m.player_red.slug $slug -}}
    {{- $isBlue := eq $m.player_blue.slug $slug -}}
    {{- $role := "" -}}
    {{- with $m.player_red.team -}}
      {{- if eq $m.player_red.base.slug $slug }}{{ $isRed = true }}{{ $role = "base" }}{{ end -}}
      {{- if eq $m.player_red.dlc.slug $slug }}{{ $isRed = true }}{{ $role = "dlc" }}{{ end -}}
    {{- end -}}
    {{- with $m.player_blue.team -}}
      {{- if eq $m.player_blue.base.slug $slug }}{{ $isBlue = true }}{{ $role = "base" }}{{ end -}}
      {{- if eq $m.player_blue.dlc.slug $slug }}{{ $isBlue = true }}{{ $role = "dlc" }}{{ end -}}
    {{- end -}}
    {{- if or $isRed $isBlue -}}
      {{- $color := "blue" -}}
      {{- $opponent := $m.player_red -}}
      {{- if $isRed -}}
        {{- $color = "red" -}}
        {{- $opponent = $m.player_blue -}}
      {{- end -}}
      {{- $won := or (and $isRed (eq $m.winner "red")) (and $isBlue (eq $m.winner "blue")) -}}
      {{- $lost := or (and $isRed (eq $m.winner "blue")) (and $isBlue (eq $m.winner "red")) -}}
      {{- $result := "pending" -}}
      {{- $seasonStats := index $bySeason $m.season_id -}}
      {{- if not $seasonStats -}}
        {{- $seasonStats = dict "wins" 0 "losses" 0 "draws" 0 -}}
      {{- end -}}
      {{- if eq $m.winner "" -}}
        {{- $noDecision = add $noDecision 1 -}}
      {{- else if eq $m.winner "draw" -}}
        {{- $draws = add $draws 1 -}}
        {{- $result = "draw" -}}
        {{- $seasonStats = dict "wins" $seasonStats.wins "losses" $seasonStats.losses "draws" (add $seasonStats.draws 1) -}}
      {{- else if $won -}}
        {{- $wins = add $wins 1 -}}
        {{- $result = "win" -}}
        {{- $seasonStats = dict "wins" (add $seasonStats.wins 1) "losses" $seasonStats.losses "draws" $seasonStats.draws -}}
      {{- else if $lost -}}
        {{- $losses = add $losses 1 -}}
        {{- $result = "loss" -}}
        {{- $seasonStats = dict "wins" $seasonStats.wins "losses" (add $seasonStats.losses 1) "draws" $seasonStats.draws -}}
      {{- end -}}
      {{- $bySeason = merge $bySeason (dict $m.season_id $seasonStats) -}}

      {{- range $g := $m.games -}}
        {{- $gt := $g.game_type -}}
        {{- $gameResult := "" -}}
        {{- if eq $g.winner_color $color -}}
          {{- $gameWins = add $gameWins 1 -}}
          {{- $gameResult = "win" -}}
        {{- else if or (eq $g.winner_color "red") (eq $g.winner_color "blue") -}}
          {{- $gameLosses = add $gameLosses 1 -}}
          {{- $gameResult = "loss" -}}
        {{- end -}}
        {{- if and $gt $gameResult -}}
          {{- $typeStats := index $byGameType $gt -}}
          {{- if not $typeStats -}}
            {{- $typeStats = dict "wins" 0 "losses" 0 -}}
          {{- end -}}
          {{- if eq $gameResult "win" -}}
            {{- $typeStats = dict "wins" (add $typeStats.wins 1) "losses" $typeStats.losses -}}
          {{- else -}}
            {{- $typeStats = dict "wins" $typeStats.wins "losses" (add $typeStats.losses 1) -}}
          {{- end -}}
          {{- $byGameType = merge $byGameType (dict $gt $typeStats) -}}
        {{- end -}}

        {{- range $g.events -}}
          {{- $ev := . -}}
          {{- if and (eq .event_type "mark") (eq (.color | default "") $color) -}}
            {{- /* The square's own pool: the game's type, or on a mixed board
                   (Season 5) the (B)/(D)/(C) tag its text ends in. */ -}}
            {{- $cellType := $gt -}}
            {{- if eq $gt "2v2" -}}
              {{- $cellType = "" -}}
              {{- range findRESubmatch ` \(([BDC])\)$` ($ev.square_text | default "") 1 -}}
                {{- $cellType = index (dict "B" "base" "D" "dlc" "C" "2v2") (index . 1) -}}
              {{- end -}}
            {{- end -}}
            {{- $mine := or (not $role) (eq $cellType $role) (eq $cellType "2v2") -}}
            {{- $sq := partial "lib/square-lookup.html" .square_text -}}
            {{- if and $mine $sq.text -}}
              {{- $key := $sq.id | default (lower $sq.text) -}}
              {{- if eq $cellType "2v2" -}}
                {{- $marks := 1 -}}
                {{- $prev := index $coopSquares $key -}}
                {{- if $prev -}}
                  {{- $marks = add $prev.marks 1 -}}
                {{- end -}}
                {{- $coopSquares = merge $coopSquares (dict $key (dict "id" $sq.id "game_type" $cellType "text" $sq.text "marks" $marks "known" $sq.known)) -}}
              {{- else if eq $cellType "dlc" -}}
                {{- $marks := 1 -}}
                {{- $prev := index $dlcSquares $key -}}
                {{- if $prev -}}
                  {{- $marks = add $prev.marks 1 -}}
                {{- end -}}
                {{- $dlcSquares = merge $dlcSquares (dict $key (dict "id" $sq.id "game_type" $cellType "text" $sq.text "marks" $marks "known" $sq.known)) -}}
              {{- else if eq $cellType "base" -}}
                {{- $marks := 1 -}}
                {{- $prev := index $baseSquares $key -}}
                {{- if $prev -}}
                  {{- $marks = add $prev.marks 1 -}}
                {{- end -}}
                {{- $baseSquares = merge $baseSquares (dict $key (dict "id" $sq.id "game_type" $cellType "text" $sq.text "marks" $marks "known" $sq.known)) -}}
              {{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}

      {{- $matches = $matches | append (dict
          "match_id" $m.key
          "match_date" $m.match_date
          "season_id" $m.season_id
          "opponent" $opponent
          "color" $color
          "result" $result
          "red_score" $m.red_score
          "blue_score" $m.blue_score
          "video_url" $m.video_url
          "path" (printf "/matches/season-%s/%s/" $m.season_id (lower $m.key))) -}}
    {{- end -}}
  {{- end -}}

  {{- $topBase := slice -}}
  {{- range $baseSquares -}}
    {{- $topBase = $topBase | append . -}}
  {{- end -}}
  {{- $topDLC := slice -}}
  {{- range $dlcSquares -}}
    {{- $topDLC = $topDLC | append . -}}
  {{- end -}}
  {{- $topCoop := slice -}}
  {{- range $coopSquares -}}
    {{- $topCoop = $topCoop | append . -}}
  {{- end -}}

  {{- /* The board insights scadustats computes into stats.yaml (pace, win
         types, first squares, comebacks, form, signature squares): unlike the
         rest of that file's stats, they need every event of every game, and
         they're regenerated from data/matches on every build. */ -}}
  {{- $insights := dict -}}
  {{- with index hugo.Data.players $slug -}}
    {{- with .stats -}}
      {{- $stats := . -}}
      {{- range $k := slice "pace" "claim_order" "claim_order_by_type" "win_types" "first_square" "comebacks" "form" "quickest_squares" "surest_squares" -}}
        {{- with index $stats $k }}{{ $insights = merge $insights (dict $k .) }}{{ end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $.AddPage (dict
      "path" $slug
      "title" $player.display_name
      "kind" "page"
      "params" (dict
        "slug" $slug
        "display_name" $player.display_name
        "twitch_url" ($player.twitch_url | default "")
        "avatar" ($player.avatar | default "")
        "bio" ($player.bio | default "")
        "unregistered" ($player.unregistered | default false)
        "source" (cond ($player.unregistered | default false) "" (printf "data/players/%s/info.yaml" $slug))
        "wins" $wins
        "losses" $losses
        "draws" $draws
        "no_decision" $noDecision
        "game_wins" $gameWins
        "game_losses" $gameLosses
        "by_game_type" $byGameType
        "by_season" $bySeason
        "top_squares_base" (first 5 (sort $topBase "marks" "desc"))
        "top_squares_dlc" (first 5 (sort $topDLC "marks" "desc"))
        "top_squares_coop" (first 5 (sort $topCoop "marks" "desc"))
        "insights" $insights
        "matches" (sort $matches "match_date" "desc"))) -}}
{{- end -}}
